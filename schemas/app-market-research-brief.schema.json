{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentdefaults.local/schemas/app-market-research-brief.schema.json",
  "title": "App Market Research Brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "platform",
    "markets",
    "seed_keywords",
    "sources",
    "outputs"
  ],
  "properties": {
    "platform": {
      "type": "string",
      "enum": [
        "wear_os",
        "android_phone",
        "android_tablet",
        "android_general"
      ]
    },
    "markets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "country",
          "locale",
          "language"
        ],
        "properties": {
          "country": {
            "type": "string",
            "pattern": "^[A-Z]{2}$",
            "description": "ISO 3166-1 alpha-2 country code, uppercase (e.g. GB, US)."
          },
          "locale": {
            "type": "string",
            "minLength": 2
          },
          "language": {
            "type": "string",
            "minLength": 2
          }
        }
      }
    },
    "seed_keywords": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "google_play_autocomplete",
          "google_play_listings",
          "reddit",
          "xda",
          "google_support",
          "manufacturer_forums",
          "public_github_issues",
          "public_web",
          "play_console"
        ]
      }
    },
    "competitor_limit_per_keyword": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 10
    },
    "date_range_months": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120,
      "default": 24
    },
    "authenticated_sources": {
      "type": "array",
      "uniqueItems": true,
      "description": "Subset of `sources` that require human-controlled authentication. Any value listed here must also appear in `sources`.",
      "items": {
        "type": "string",
        "enum": [
          "play_console"
        ]
      },
      "default": []
    },
    "developer_constraints": {
      "type": "object",
      "additionalProperties": true
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "csv",
          "json",
          "markdown",
          "screenshots",
          "browser_walkthrough"
        ]
      }
    },
    "scoring_weights": {
      "type": "object",
      "description": "Weights per scoring dimension defined in skills/market-opportunity-clustering.md. Keys not defined there are ignored at scoring time.",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    }
  }
}
