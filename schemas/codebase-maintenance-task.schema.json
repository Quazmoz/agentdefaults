{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Quazmoz/agentdefaults/schemas/codebase-maintenance-task.schema.json",
  "title": "Codebase Maintenance Task",
  "description": "Structured contract for behavior-preserving codebase de-slop, refactoring, comment reconciliation, and efficiency work.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target",
    "mode",
    "goal",
    "behavior_policy",
    "authority"
  ],
  "properties": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref", "scope"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1}
      }
    },
    "mode": {
      "type": "string",
      "enum": ["audit", "de_slop", "refactor", "comment_reconcile", "efficiency"]
    },
    "goal": {"type": "string", "minLength": 1},
    "non_goals": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "behavior_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow_behavior_changes", "reconcile_touched_comments"],
      "properties": {
        "allow_behavior_changes": {"type": "boolean", "default": false},
        "preserved_contracts": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "authorized_behavior_changes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "reconcile_touched_comments": {"type": "boolean"},
        "allow_repository_wide_formatting": {"type": "boolean", "default": false},
        "allow_new_dependencies": {"type": "boolean", "default": false}
      }
    },
    "focus": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "comment_drift",
          "duplication",
          "dead_code",
          "abstraction_inflation",
          "failure_semantics",
          "test_quality",
          "dependencies",
          "configuration",
          "performance",
          "concurrency_lifecycle",
          "naming_contracts",
          "all_relevant"
        ]
      },
      "uniqueItems": true
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_permission_class"],
      "properties": {
        "maximum_permission_class": {
          "type": "string",
          "enum": ["observe", "propose", "mutate_reversible", "mutate_irreversible"]
        },
        "authorized_mutations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "approval_required": {"type": "boolean", "default": false},
        "approval_gates": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_checks": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "targeted_regressions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "performance_evidence": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "postconditions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"mode": {"const": "audit"}},
        "required": ["mode"]
      },
      "then": {
        "properties": {
          "authority": {
            "properties": {
              "maximum_permission_class": {"enum": ["observe", "propose"]}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {"enum": ["de_slop", "refactor", "comment_reconcile", "efficiency"]}
        },
        "required": ["mode"]
      },
      "then": {
        "required": ["verification"],
        "properties": {
          "behavior_policy": {
            "required": ["reconcile_touched_comments"],
            "properties": {
              "reconcile_touched_comments": {"const": true}
            }
          },
          "authority": {
            "required": ["authorized_mutations"],
            "properties": {
              "maximum_permission_class": {
                "enum": ["mutate_reversible", "mutate_irreversible"]
              },
              "authorized_mutations": {"minItems": 1}
            }
          },
          "verification": {
            "required": ["required_checks", "postconditions"],
            "properties": {
              "required_checks": {"minItems": 1},
              "postconditions": {"minItems": 1}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "behavior_policy": {
            "properties": {"allow_behavior_changes": {"const": true}},
            "required": ["allow_behavior_changes"]
          }
        }
      },
      "then": {
        "properties": {
          "behavior_policy": {
            "required": ["authorized_behavior_changes"],
            "properties": {
              "authorized_behavior_changes": {"minItems": 1}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "authority": {
            "properties": {"maximum_permission_class": {"const": "mutate_irreversible"}},
            "required": ["maximum_permission_class"]
          }
        }
      },
      "then": {
        "properties": {
          "authority": {
            "required": ["approval_required", "approval_gates"],
            "properties": {
              "approval_required": {"const": true},
              "approval_gates": {"minItems": 1}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"mode": {"const": "efficiency"}},
        "required": ["mode"]
      },
      "then": {
        "properties": {
          "verification": {
            "required": ["performance_evidence"],
            "properties": {
              "performance_evidence": {"minItems": 1}
            }
          }
        }
      }
    }
  ]
}
