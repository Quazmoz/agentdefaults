{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Quazmoz/agentdefaults/schemas/codebase-maintenance-task.schema.json",
  "title": "Codebase Maintenance Task",
  "description": "Structured contract for behavior-preserving codebase de-slop, refactoring, comment reconciliation, generated-artifact discipline, and efficiency work.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target",
    "mode",
    "goal",
    "behavior_policy",
    "evidence_policy",
    "churn_policy",
    "authority"
  ],
  "properties": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref", "scope"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "exclusions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "mode": {
      "type": "string",
      "enum": ["audit", "de_slop", "refactor", "comment_reconcile", "efficiency"]
    },
    "goal": {"type": "string", "minLength": 1},
    "non_goals": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "behavior_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow_behavior_changes",
        "reconcile_touched_comments",
        "generated_artifact_policy",
        "require_history_for_ambiguous_intent"
      ],
      "properties": {
        "allow_behavior_changes": {"type": "boolean", "default": false},
        "preserved_contracts": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "authorized_behavior_changes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "reconcile_touched_comments": {"type": "boolean"},
        "allow_repository_wide_formatting": {"type": "boolean", "default": false},
        "allow_new_dependencies": {"type": "boolean", "default": false},
        "generated_artifact_policy": {
          "type": "string",
          "enum": ["source_and_regenerate", "preserve", "direct_edit_authorized"]
        },
        "direct_generated_edit_justification": {"type": "string", "minLength": 1},
        "require_history_for_ambiguous_intent": {"type": "boolean"},
        "characterization_policy": {
          "type": "string",
          "enum": ["contract_only", "review_incidental_before_locking"],
          "default": "review_incidental_before_locking"
        }
      }
    },
    "evidence_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_removal_confidence",
        "distinguish_contractual_from_incidental_behavior",
        "require_independent_evidence_for_high_blast_radius"
      ],
      "properties": {
        "minimum_removal_confidence": {
          "type": "string",
          "enum": ["medium", "high", "very_high"]
        },
        "distinguish_contractual_from_incidental_behavior": {"type": "boolean"},
        "require_independent_evidence_for_high_blast_radius": {"type": "boolean"}
      }
    },
    "churn_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow_unrelated_formatting", "require_independent_slice_verification"],
      "properties": {
        "allow_unrelated_formatting": {"type": "boolean"},
        "require_independent_slice_verification": {"type": "boolean"},
        "max_files_per_slice": {"type": "integer", "minimum": 1}
      }
    },
    "focus": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "comment_drift",
          "duplication",
          "dead_code",
          "abstraction_inflation",
          "failure_semantics",
          "test_quality",
          "dependencies",
          "configuration",
          "generated_artifacts",
          "performance",
          "concurrency_lifecycle",
          "naming_contracts",
          "discoverability_context",
          "all_relevant"
        ]
      },
      "uniqueItems": true
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_permission_class"],
      "properties": {
        "maximum_permission_class": {
          "type": "string",
          "enum": ["observe", "propose", "mutate_reversible", "mutate_irreversible"]
        },
        "authorized_mutations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "approval_required": {"type": "boolean", "default": false},
        "approval_gates": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_checks": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "compatibility_checks": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "targeted_regressions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "performance_evidence": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "reproducibility_checks": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "postconditions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"mode": {"const": "audit"}},
        "required": ["mode"]
      },
      "then": {
        "properties": {
          "authority": {
            "properties": {
              "maximum_permission_class": {"enum": ["observe", "propose"]}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {"enum": ["de_slop", "refactor", "comment_reconcile", "efficiency"]}
        },
        "required": ["mode"]
      },
      "then": {
        "required": ["verification"],
        "properties": {
          "behavior_policy": {
            "required": ["reconcile_touched_comments"],
            "properties": {
              "reconcile_touched_comments": {"const": true}
            }
          },
          "authority": {
            "required": ["authorized_mutations"],
            "properties": {
              "maximum_permission_class": {
                "enum": ["mutate_reversible", "mutate_irreversible"]
              },
              "authorized_mutations": {"minItems": 1}
            }
          },
          "verification": {
            "required": ["required_checks", "compatibility_checks", "postconditions"],
            "properties": {
              "required_checks": {"minItems": 1},
              "compatibility_checks": {"minItems": 1},
              "postconditions": {"minItems": 1}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "behavior_policy": {
            "properties": {"allow_behavior_changes": {"const": true}},
            "required": ["allow_behavior_changes"]
          }
        }
      },
      "then": {
        "properties": {
          "behavior_policy": {
            "required": ["authorized_behavior_changes"],
            "properties": {
              "authorized_behavior_changes": {"minItems": 1}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "behavior_policy": {
            "properties": {"generated_artifact_policy": {"const": "direct_edit_authorized"}},
            "required": ["generated_artifact_policy"]
          }
        }
      },
      "then": {
        "properties": {
          "behavior_policy": {
            "required": ["direct_generated_edit_justification"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "authority": {
            "properties": {"maximum_permission_class": {"const": "mutate_irreversible"}},
            "required": ["maximum_permission_class"]
          }
        }
      },
      "then": {
        "properties": {
          "authority": {
            "required": ["approval_required", "approval_gates"],
            "properties": {
              "approval_required": {"const": true},
              "approval_gates": {"minItems": 1}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"mode": {"const": "efficiency"}},
        "required": ["mode"]
      },
      "then": {
        "properties": {
          "verification": {
            "required": ["performance_evidence"],
            "properties": {
              "performance_evidence": {"minItems": 1}
            }
          }
        }
      }
    }
  ]
}
