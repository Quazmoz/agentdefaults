{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Quazmoz/agentdefaults/schemas/bounded-completion-findings.schema.json",
  "title": "Bounded Completion Findings",
  "type": "object",
  "required": ["task_id", "findings"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "severity", "blocking", "acceptance_criterion", "location", "evidence", "procedure", "expected", "actual", "recommended_correction", "owner", "hypothesis", "disposition"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "severity": {"enum": ["critical", "high", "medium", "low", "informational"]},
          "blocking": {"type": "boolean"},
          "acceptance_criterion": {"type": ["string", "null"]},
          "location": {"type": "string"},
          "evidence": {"type": "string"},
          "procedure": {"type": "string"},
          "expected": {"type": "string"},
          "actual": {"type": "string"},
          "recommended_correction": {"type": "string"},
          "owner": {"type": "string"},
          "hypothesis": {"type": "boolean"},
          "disposition": {"enum": ["unresolved", "accepted-blocking", "accepted-non-blocking", "rejected-with-evidence", "duplicate-resolved", "requires-user-input", "deferred-out-of-scope"]},
          "resolution_evidence": {"type": ["string", "null"]}
        }
      }
    }
  }
}
