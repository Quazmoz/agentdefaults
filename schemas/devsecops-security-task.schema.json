{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Quazmoz/agentdefaults/schemas/devsecops-security-task.schema.json",
  "title": "DevSecOps Security Engineering Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "goal",
    "mode",
    "platforms",
    "target",
    "authority",
    "acceptance"
  ],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "mode": {
      "type": "string",
      "enum": ["investigate", "review", "design", "implement", "incident", "release"]
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "terraform",
          "opentofu",
          "ansible",
          "automation_platform",
          "jenkins",
          "ci_cd",
          "gitops",
          "kubernetes",
          "containers",
          "cloud_iam",
          "artifact_supply_chain",
          "other"
        ]
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identifier"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["repository", "platform", "service", "environment", "incident", "release", "mixed", "other"]
        },
        "identifier": {"type": "string", "minLength": 1},
        "branch_or_version": {"type": "string", "minLength": 1},
        "environment": {"type": "string", "minLength": 1},
        "paths": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "threat_model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assets": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "trust_boundaries": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "attacker_controlled_inputs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "privileged_identities": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "sensitive_data": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "realistic_threats": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repositories": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "systems": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "audit_logs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "plans_or_diffs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "vendor_sources": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "required_sources": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_permission_class"],
      "properties": {
        "maximum_permission_class": {
          "type": "string",
          "enum": ["observe", "propose", "mutate_reversible", "mutate_irreversible"]
        },
        "authorized_mutations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true,
          "default": []
        },
        "approval_required": {"type": "boolean", "default": false},
        "approval_gates": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true,
          "default": []
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "non_goals": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "availability_requirements": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "compatibility_requirements": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "compliance_frameworks": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "forbidden_actions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_checks": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "security_postconditions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "adversarial_cases": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "rollback_checks": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "implement"}}, "required": ["mode"]},
      "then": {
        "required": ["verification"],
        "properties": {
          "authority": {
            "required": ["authorized_mutations"],
            "properties": {
              "maximum_permission_class": {"enum": ["mutate_reversible", "mutate_irreversible"]},
              "authorized_mutations": {"minItems": 1}
            }
          },
          "verification": {
            "required": ["required_checks", "security_postconditions", "adversarial_cases"],
            "properties": {
              "required_checks": {"minItems": 1},
              "security_postconditions": {"minItems": 1},
              "adversarial_cases": {"minItems": 1}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"mode": {"const": "release"}}, "required": ["mode"]},
      "then": {
        "required": ["verification"],
        "properties": {
          "verification": {
            "required": ["required_checks", "security_postconditions", "adversarial_cases", "rollback_checks"],
            "properties": {
              "required_checks": {"minItems": 1},
              "security_postconditions": {"minItems": 1},
              "adversarial_cases": {"minItems": 1},
              "rollback_checks": {"minItems": 1}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"mode": {"const": "incident"}}, "required": ["mode"]},
      "then": {
        "required": ["threat_model"],
        "properties": {
          "threat_model": {
            "required": ["assets", "trust_boundaries", "privileged_identities", "realistic_threats"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "authority": {
            "properties": {
              "maximum_permission_class": {"const": "mutate_irreversible"}
            },
            "required": ["maximum_permission_class"]
          }
        }
      },
      "then": {
        "properties": {
          "authority": {
            "required": ["approval_required", "approval_gates", "authorized_mutations"],
            "properties": {
              "approval_required": {"const": true},
              "approval_gates": {"minItems": 1},
              "authorized_mutations": {"minItems": 1}
            }
          }
        }
      }
    }
  ]
}
